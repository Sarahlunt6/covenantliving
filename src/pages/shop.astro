---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { PRODUCTS } from '../data/products';
import { CATALOG_SECTIONS, SITE } from '../data/site';

const sectionSlug = (s: string) => s.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-');
const groups = CATALOG_SECTIONS.map((name) => ({
  name,
  id: sectionSlug(name),
  products: PRODUCTS.filter((p) => p.section === name),
})).filter((g) => g.products.length > 0);
---

<Base title="Shop" description="Browse Covenant Living printables: Come Follow Me, missionary, Primary, baptism, and scripture art. Every purchase is an instant download on Etsy.">
  <section class="wrap section">
    <p class="eyebrow">Shop</p>
    <h1>Printables</h1>
    <p class="muted lead">
      Every printable is an instant download, sold and delivered through Etsy.
      <a href={SITE.etsyShopUrl} target="_blank" rel="noopener">See the full shop on Etsy</a>.
    </p>

    {groups.map((g) => (
      <section class="group" id={g.id}>
        <h2>{g.name}</h2>
        <div class="grid grid--3">
          {g.products.map((p) => <ProductCard product={p} />)}
        </div>
      </section>
    ))}
  </section>
</Base>

<style>
  .lead { max-width: 640px; }
  .group { scroll-margin-top: 96px; }
  .group h2 { margin-top: 1.4em; }
</style>
