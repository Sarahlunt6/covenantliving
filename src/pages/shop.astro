---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import { PRODUCTS } from '../data/products';
import { CATALOG_SECTIONS, SITE } from '../data/site';

const sectionSlug = (s: string) => s.toLowerCase().replace(/&/g, 'and').replace(/[^a-z0-9]+/g, '-');
const sections = CATALOG_SECTIONS.filter((name) => PRODUCTS.some((p) => p.section === name));
// Products with photos first, so the top of the grid is the most visual
const products = [...PRODUCTS].sort((a, b) => Number(!!b.image) - Number(!!a.image));
---

<Base title="Shop" description="Browse Covenant Living printables: Come Follow Me, missionary, Primary, baptism, and scripture art. Every purchase is an instant download on Etsy.">
  <section class="page-head">
    <div class="wrap">
      <p class="eyebrow" data-reveal>Shop</p>
      <h1 data-reveal style="--d: 100ms">Printables for every season of gospel living</h1>
      <p class="muted lead" data-reveal style="--d: 200ms">
        Every printable is an instant download, sold and delivered through Etsy.
        <a href={SITE.etsyShopUrl} target="_blank" rel="noopener">See the full shop on Etsy</a>.
      </p>
    </div>
  </section>

  <section class="wrap">
    <div class="chips" data-filters="shop-grid" role="group" aria-label="Filter by collection">
      <button class="chip" type="button" data-filter="all" data-hash="" aria-pressed="true">All</button>
      {sections.map((s) => (
        <button class="chip" type="button" data-filter={s} data-hash={sectionSlug(s)} aria-pressed="false">{s}</button>
      ))}
    </div>

    <div class="grid grid--3 grid--stagger" id="shop-grid">
      {products.map((p, i) => <ProductCard product={p} delay={(i % 3) * 100} />)}
    </div>
  </section>
</Base>

<style>
  .page-head { padding: 72px 0 8px; }
  .page-head h1 { max-width: 760px; font-size: clamp(2.4rem, 5.4vw, 4rem); line-height: 1.05; }
  .lead { max-width: 640px; font-size: 1.1rem; }
</style>
