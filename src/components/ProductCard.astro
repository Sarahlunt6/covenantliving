---
import type { Product } from '../data/products';
import { SITE } from '../data/site';

interface Props {
  product: Product;
  wide?: boolean;
  /** Stagger for the scroll-in animation, in ms */
  delay?: number;
}

const { product, wide = false, delay = 0 } = Astro.props;
const href = product.etsyUrl || SITE.etsyShopUrl;
---

<article
  class:list={['card', 'product', { wide }]}
  data-reveal
  data-filter-item={product.section}
  style={`--d: ${delay}ms`}
>
  <a class="thumb" href={href} rel="noopener" target="_blank" tabindex="-1" aria-hidden="true">
    {product.image ? (
      <img src={product.image} alt="" loading="lazy" width="800" height="800" />
    ) : (
      <div class="placeholder">
        <span class="ph-section">{product.section}</span>
        <span class="ph-name">{product.name}</span>
      </div>
    )}
    <span class="peek">View on Etsy</span>
  </a>
  {product.previews?.length ? (
    <button
      class="peek-btn"
      type="button"
      data-peek={JSON.stringify(product.previews)}
      data-peek-title={product.name}
      data-peek-href={href}
    >
      Peek inside
      <span class="count">{product.previews.length}</span>
    </button>
  ) : null}
  <div class="body">
    <p class="eyebrow">{product.section}</p>
    <h3>{product.name}</h3>
    <p class="muted">{product.blurb}</p>
    <div class="buy">
      {product.price && <span class="price">{product.price}</span>}
      <a class="btn" href={href} rel="noopener" target="_blank">View on Etsy</a>
    </div>
  </div>
</article>

<style>
  .product { position: relative; }
  .product h3 { font-size: 1.45rem; margin: 0.2em 0 0.3em; }
  .peek-btn {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--forest);
    background: rgb(251 247 239 / 0.94);
    border: 0;
    border-radius: 999px;
    padding: 0.45em 0.6em 0.45em 1em;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.15);
    cursor: pointer;
    transition: transform 0.25s var(--ease), background 0.25s;
  }
  .peek-btn:hover { transform: translateY(-2px); background: var(--white); }
  .count {
    display: inline-grid;
    place-items: center;
    min-width: 1.6em;
    height: 1.6em;
    border-radius: 999px;
    background: var(--sage-deep);
    color: var(--white);
    font-size: 0.75rem;
  }
  .wide .peek-btn { left: 14px; right: auto; }
  .product p { margin: 0 0 12px; }
  .thumb {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    text-decoration: none;
    background: var(--cream-deep);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }
  .product:hover .thumb img { transform: scale(1.07); }
  .peek {
    position: absolute;
    left: 14px;
    bottom: 14px;
    background: rgb(44 54 39 / 0.88);
    color: var(--cream);
    font-weight: 700;
    font-size: 0.85rem;
    padding: 0.45em 1em;
    border-radius: 999px;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.35s, transform 0.35s var(--ease);
  }
  .product:hover .peek { opacity: 1; transform: none; }
  .placeholder {
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
    padding: 28px;
    color: var(--cream);
    background:
      radial-gradient(circle at 80% 15%, rgb(201 169 106 / 0.45), transparent 50%),
      linear-gradient(160deg, var(--sage-deep), var(--forest));
    transition: transform 0.9s var(--ease);
  }
  .product:hover .placeholder { transform: scale(1.04); }
  .ph-section {
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--gold);
  }
  .ph-name { font-family: var(--serif); font-style: italic; font-size: 1.9rem; line-height: 1.1; }
  .body { padding: 22px; display: flex; flex-direction: column; flex: 1; }
  .buy { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .price { font-family: var(--serif); font-weight: 600; font-size: 1.5rem; }
  .wide { flex-direction: row; margin: 2em 0; }
  .wide .thumb { width: 40%; flex-shrink: 0; }
  @media (max-width: 560px) {
    .wide { flex-direction: column; }
    .wide .thumb { width: 100%; }
  }
  @media (hover: none) {
    .peek { display: none; }
  }
</style>
