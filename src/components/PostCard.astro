---
import type { CollectionEntry } from 'astro:content';
import { getProduct } from '../data/products';

interface Props {
  post: CollectionEntry<'blog'>;
  /** Large card for the lead story */
  feature?: boolean;
  delay?: number;
}

const { post, feature = false, delay = 0 } = Astro.props;
const { title, description, category, heroImage, pubDate } = post.data;
// No hero image yet? Use the matching product's photo so every card has a picture.
const image = heroImage ?? getProduct(post.data.product)?.image;
const date = pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });
---

<a
  class:list={['card', 'post', { feature }]}
  href={`/blog/${post.id}/`}
  data-reveal
  data-filter-item={category}
  style={`--d: ${delay}ms`}
>
  <div class="thumb">
    {image ? <img src={image} alt="" loading="lazy" width="800" height="800" /> : <div class="ph" aria-hidden="true" />}
    <span class="tag">{category}{post.data.draft && ' · Draft'}</span>
  </div>
  <div class="body">
    <h3>{title}</h3>
    <p class="muted small desc">{description}</p>
    <p class="small muted date">{date} <span class="read-more">Read the post</span></p>
  </div>
</a>

<style>
  .post { text-decoration: none; color: inherit; }
  .thumb { position: relative; aspect-ratio: 3 / 2; overflow: hidden; background: var(--cream-deep); }
  .feature .thumb { aspect-ratio: 4 / 3; }
  .thumb img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s var(--ease); }
  .post:hover .thumb img { transform: scale(1.07); }
  .ph { height: 100%; background: linear-gradient(135deg, rgb(138 154 123 / 0.35), rgb(217 196 154 / 0.45)); }
  .tag {
    position: absolute;
    top: 14px;
    left: 14px;
    background: rgb(251 247 239 / 0.92);
    color: var(--sage-deep);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.4em 0.9em;
    border-radius: 999px;
  }
  .body { padding: 22px; display: flex; flex-direction: column; flex: 1; }
  .body h3 { margin: 0 0 0.4em; font-size: 1.5rem; transition: color 0.25s; }
  .feature .body h3 { font-size: clamp(1.7rem, 3vw, 2.3rem); }
  .post:hover h3 { color: var(--sage-deep); }
  .body p { margin: 0 0 10px; }
  .date { margin: auto 0 0; display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .read-more { color: var(--sage-deep); font-weight: 700; }
  .read-more::after { content: ' →'; display: inline-block; transition: transform 0.3s var(--ease); }
  .post:hover .read-more::after { transform: translateX(4px); }
</style>
